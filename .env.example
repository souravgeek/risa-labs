# Local SQLite is automatic when Supabase is unconfigured.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only for `npm run db:init` (Connect → Session pooler URI with the DB password).
SUPABASE_DB_URL=
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.8-live
CRON_SECRET=
# In-app phone call (optional overrides)
GEMINI_CALL_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite
GEMINI_CALL_HEDGE_MS=2000
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
